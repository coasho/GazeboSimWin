diff --git a/src/cmd/gz_sim_headless_main.cc b/src/cmd/gz_sim_headless_main.cc
new file mode 100644
index 0000000..d6dfba1
--- /dev/null
+++ b/src/cmd/gz_sim_headless_main.cc
@@ -0,0 +1,309 @@
+/*
+ * Copyright (C) 2026 Open Source Robotics Foundation
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ */
+
+// Native replacement for "gz sim -s" (the Ruby command line is not part of
+// the headless build). The options and the world file lookup follow
+// src/cmd/cmdsim.rb.in; ERB templates are not supported.
+
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <gz/common/Filesystem.hh>
+#include <gz/common/SystemPaths.hh>
+#include <gz/common/Util.hh>
+#include <gz/msgs/world_stats.pb.h>
+#include <gz/transport/Node.hh>
+#include <gz/utils/cli/CLI.hpp>
+#include <gz/utils/cli/GzFormatter.hpp>
+
+#include "gz/sim/config.hh"
+#include "gz.hh"
+
+// Last, so that its macros do not clash with protobuf / gz headers.
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace
+{
+/// \brief World loaded when the executable is started without a world,
+/// e.g. by double clicking it. Installed with the example worlds.
+const char kDefaultWorld[] = "headless_default.sdf";
+
+//////////////////////////////////////////////////
+/// \brief Resolve a world argument like the Ruby command line does: existing
+/// file, GZ_SIM_RESOURCE_PATH, installed worlds, then Fuel.
+std::string resolveWorld(const std::string &_file)
+{
+  if (gz::common::isFile(_file))
+    return _file;
+
+  std::string resourcePaths;
+  if (gz::common::env("GZ_SIM_RESOURCE_PATH", resourcePaths))
+  {
+    for (const auto &dir : gz::common::SystemPaths::PathsFromEnv(
+             "GZ_SIM_RESOURCE_PATH"))
+    {
+      const auto candidate = gz::common::joinPaths(dir, _file);
+      if (gz::common::isFile(candidate))
+        return candidate;
+    }
+  }
+
+  const auto installed = gz::common::joinPaths(worldInstallDir(), _file);
+  if (gz::common::isFile(installed))
+    return installed;
+
+  std::vector<char> uri(_file.begin(), _file.end());
+  uri.push_back('\0');
+  const char *fuel = findFuelResource(uri.data());
+  return fuel ? std::string(fuel) : std::string();
+}
+
+//////////////////////////////////////////////////
+/// \brief Plugins are loaded with LOAD_WITH_ALTERED_SEARCH_PATH (dlfcn-win32),
+/// which does not search the executable directory for their dependencies.
+/// Add it explicitly so the DLLs shipped next to the executable are found.
+void addExecutableDirToDllSearchPath()
+{
+#ifdef _WIN32
+  wchar_t exePath[MAX_PATH * 4];
+  const DWORD len = GetModuleFileNameW(nullptr, exePath,
+      static_cast<DWORD>(sizeof(exePath) / sizeof(exePath[0])));
+  if (len == 0)
+    return;
+  std::wstring dir(exePath, len);
+  const auto slash = dir.find_last_of(L"\\/");
+  if (slash == std::wstring::npos)
+    return;
+  dir.resize(slash);
+  SetDllDirectoryW(dir.c_str());
+
+  // Also for child processes and libraries that rely on PATH.
+  const DWORD needed = GetEnvironmentVariableW(L"PATH", nullptr, 0);
+  std::wstring path;
+  if (needed > 0)
+  {
+    path.resize(needed);
+    const DWORD written = GetEnvironmentVariableW(L"PATH", &path[0], needed);
+    path.resize(written);
+  }
+  SetEnvironmentVariableW(L"PATH", (dir + L";" + path).c_str());
+#endif
+}
+
+//////////////////////////////////////////////////
+/// \brief True if this process owns its console window, i.e. it was started
+/// from Explorer rather than from a terminal.
+bool ownsConsole()
+{
+#ifdef _WIN32
+  DWORD pids[2];
+  return GetConsoleProcessList(pids, 2) <= 1;
+#else
+  return false;
+#endif
+}
+
+//////////////////////////////////////////////////
+void waitForEnterIfOwnConsole()
+{
+  if (ownsConsole())
+  {
+    std::cout << "\nPress Enter to close this window..." << std::flush;
+    std::string line;
+    std::getline(std::cin, line);
+  }
+}
+}  // namespace
+
+//////////////////////////////////////////////////
+int main(int argc, char **argv)
+{
+  std::string file;
+  int iterations{0};
+  bool run{false};
+  float hz{-1.0f};
+  double initialSimTime{0.0};
+  bool levels{false};
+  std::string networkRole;
+  int networkSecondaries{0};
+  bool record{false};
+  std::string recordPath;
+  bool recordResources{false};
+  std::vector<std::string> recordTopics;
+  float recordPeriod{-1.0f};
+  bool logOverwrite{false};
+  bool logCompress{false};
+  std::string playback;
+  std::string verbose{"1"};
+  std::string physicsEngine;
+  int seed{0};
+  bool stats{false};
+
+  CLI::App app{"Gazebo Sim " GZ_SIM_VERSION_FULL
+               " headless server (no GUI, no rendering)"};
+  app.add_flag_callback("--version", []()
+  {
+    std::cout << simVersionHeader();
+    throw CLI::Success();
+  }, "Print Gazebo version information.");
+  app.add_option("file", file,
+      "SDF world file. Absolute/relative path, a file in "
+      "GZ_SIM_RESOURCE_PATH or the installed worlds, or a Fuel URL.");
+  app.add_flag("-r", run, "Run simulation on start.");
+  app.add_option("-v,--verbose", verbose,
+      "Adjust the level of console output (0~4). The default verbosity is 1, "
+      "use -v without arguments for level 3.")
+      ->expected(0, 1)->default_str("3");
+  app.add_option("--iterations", iterations,
+      "Number of iterations to execute.");
+  app.add_option("-z", hz, "Update rate in Hertz.");
+  app.add_option("--initial-sim-time", initialSimTime,
+      "Initial simulation time, in seconds.");
+  app.add_flag("--levels", levels, "Use the level system.");
+  app.add_option("--network-role", networkRole,
+      "Participant role used in a distributed simulation environment "
+      "[primary, secondary]. It implies --levels.");
+  app.add_option("--network-secondaries", networkSecondaries,
+      "Number of secondary participants expected to join (primary only).");
+  app.add_flag("--record", record,
+      "Use logging system to record states and console messages.");
+  app.add_option("--record-path", recordPath,
+      "Implicitly invokes --record, and specifies the record path.");
+  app.add_flag("--record-resources", recordResources,
+      "Implicitly invokes --record, and records meshes and materials.");
+  app.add_option("--record-topic", recordTopics,
+      "Additional topic (regex) to record. Can be repeated.");
+  app.add_option("--record-period", recordPeriod,
+      "Time period (seconds) between state recording.");
+  app.add_flag("--log-overwrite", logOverwrite,
+      "When recording, overwrite existing files.");
+  app.add_flag("--log-compress", logCompress,
+      "When recording, compress final log files.");
+  app.add_option("--playback", playback,
+      "Use logging system to play back states from this path.");
+  app.add_option("--physics-engine", physicsEngine,
+      "Physics engine plugin to load (default gz-physics-dartsim-plugin), "
+      "e.g. gz-physics-bullet-featherstone-plugin.");
+  app.add_option("--seed", seed,
+      "Seed value for the random number generator.");
+  app.add_flag("--stats", stats,
+      "Print simulation time and real time factor once per second.");
+  app.formatter(std::make_shared<GzFormatter>(&app));
+
+  CLI11_PARSE(app, argc, argv);
+
+  addExecutableDirToDllSearchPath();
+
+  // Started without a world (e.g. double click): run the bundled demo world.
+  const bool defaultMode = file.empty() && playback.empty();
+  if (defaultMode)
+  {
+    file = kDefaultWorld;
+    run = true;
+    stats = true;
+    if (app.count("-v") == 0)
+      verbose = "3";
+    std::cout << "No world file given, running [" << kDefaultWorld
+              << "]. Press Ctrl+C to stop.\n"
+              << "Run with --help to see all options.\n" << std::endl;
+  }
+
+  cmdVerbosity(verbose.c_str());
+
+  std::string sdfString;
+  if (!file.empty())
+  {
+    const std::string path = resolveWorld(file);
+    if (path.empty())
+    {
+      std::cerr << "Unable to find or download file " << file << std::endl;
+      waitForEnterIfOwnConsole();
+      return -1;
+    }
+    std::ifstream in(path, std::ios::binary);
+    if (!in)
+    {
+      std::cerr << "Unable to read file " << path << std::endl;
+      waitForEnterIfOwnConsole();
+      return -1;
+    }
+    std::stringstream buffer;
+    buffer << in.rdbuf();
+    sdfString = buffer.str();
+    file = path;
+  }
+
+  if (!recordPath.empty() || recordResources || !recordTopics.empty())
+    record = true;
+
+  std::string topics;
+  for (const auto &t : recordTopics)
+    topics += (topics.empty() ? "" : ":") + t;
+
+  // Same as the Ruby command line for the server process.
+  gz::common::setenv("RMT_PORT", "1500");
+
+  gz::transport::Node node;
+  if (stats)
+  {
+    std::function<void(const gz::msgs::WorldStatistics &)> onStats =
+      [](const gz::msgs::WorldStatistics &_msg)
+      {
+        static int64_t lastSec = -1;
+        const auto &simTime = _msg.sim_time();
+        if (simTime.sec() == lastSec)
+          return;
+        lastSec = simTime.sec();
+        std::ostringstream line;
+        line.setf(std::ios::fixed);
+        line.precision(2);
+        line << "sim time " << simTime.sec() + simTime.nsec() * 1e-9
+             << " s | real time factor " << _msg.real_time_factor()
+             << " | iterations " << _msg.iterations()
+             << (_msg.paused() ? " | paused" : "");
+#ifdef _WIN32
+        SetConsoleTitleA(("gz-sim-headless | " + line.str()).c_str());
+#endif
+        std::cout << line.str() << std::endl;
+      };
+    node.Subscribe("/stats", onStats);
+  }
+
+  const int result = runServer(sdfString.c_str(), iterations, run ? 1 : 0, hz,
+      initialSimTime, levels ? 1 : 0, networkRole.c_str(), networkSecondaries,
+      record ? 1 : 0, recordPath.c_str(), recordResources ? 1 : 0,
+      logOverwrite ? 1 : 0, logCompress ? 1 : 0, playback.c_str(),
+      physicsEngine.c_str(), "", "", "", "", file.c_str(), topics.c_str(),
+      /* _waitGui */ 0, /* _headless */ 1, recordPeriod, seed);
+
+  if (result != 0 || defaultMode)
+    waitForEnterIfOwnConsole();
+  return result;
+}
