diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf2fa72..59d47e5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,6 +23,11 @@ gz_configure_project(VERSION_SUFFIX)
 #============================================================================
 set (DRI_TESTS TRUE CACHE BOOL "True to enable DRI tests")
 
+#--------------------------------------
+# Option: Build only the sensors that do not need gz-rendering (headless build).
+option(GZ_SENSORS_WITHOUT_RENDERING
+  "Skip gz-rendering and every rendering based sensor component" OFF)
+
 option(ENABLE_PROFILER "Enable Gazebo Profiler" FALSE)
 
 if(ENABLE_PROFILER)
@@ -67,17 +72,19 @@ if ((NOT ${CMAKE_VERSION} VERSION_LESS 3.11) AND (NOT OpenGL_GL_PREFERENCE))
   set(OpenGL_GL_PREFERENCE "GLVND")
 endif()
 
-gz_find_package(gz-rendering8 REQUIRED OPTIONAL_COMPONENTS ogre ogre2)
-set(GZ_RENDERING_VER ${gz-rendering8_VERSION_MAJOR})
+if(NOT GZ_SENSORS_WITHOUT_RENDERING)
+  gz_find_package(gz-rendering8 REQUIRED OPTIONAL_COMPONENTS ogre ogre2)
+  set(GZ_RENDERING_VER ${gz-rendering8_VERSION_MAJOR})
 
-if (TARGET gz-rendering${GZ_RENDERING_VER}::ogre)
-  set(HAVE_OGRE TRUE)
-  add_definitions(-DWITH_OGRE)
-endif()
+  if (TARGET gz-rendering${GZ_RENDERING_VER}::ogre)
+    set(HAVE_OGRE TRUE)
+    add_definitions(-DWITH_OGRE)
+  endif()
 
-if (TARGET gz-rendering${GZ_RENDERING_VER}::ogre2)
-  set(HAVE_OGRE2 TRUE)
-  add_definitions(-DWITH_OGRE2)
+  if (TARGET gz-rendering${GZ_RENDERING_VER}::ogre2)
+    set(HAVE_OGRE2 TRUE)
+    add_definitions(-DWITH_OGRE2)
+  endif()
 endif()
 
 #--------------------------------------
