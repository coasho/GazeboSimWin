<?xml version="1.0" encoding="UTF-8"?>
<!--
  无渲染运行配置示例，仅用于检查配置加载、刚体运动与传感器输出，不是飞机模型。
  数值沿用本补丁 headless_default.sdf 的演示设定，惯量改用均匀立方体公式。
  参数来源及换平台调整方法见 docs/gazebo-configuration.md。
-->
<sdf version="1.9">
  <world name="headless_demo">
    <!-- 步长单位 s；此示例用 1 ms、目标实时因子 1，实际速度取决于机器负载。 -->
    <physics name="demo_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- type="ignored" 不选择引擎；下面的 engine 才指定 DART，可被命令行覆盖。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 演示采用 Z 向上，重力沿 -Z，单位 m/s^2；不是某试验场的实测值。 -->
    <gravity>0 0 -9.8</gravity>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="box">
      <!-- x y z roll pitch yaw，单位 m / rad；初始质心高度为演示配置 5 m。 -->
      <pose>0 0 5 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>10</update_frequency>
      </plugin>
      <link name="body">
        <inertial>
          <!-- 示例为质心居中的均匀立方体，质量 1 kg、边长 1 m。 -->
          <pose>0 0 0 0 0 0</pose>
          <mass>1.0</mass>
          <inertia>
            <!-- Ixx=m*(y*y+z*z)/12=1/6 kg*m^2，另两轴同理；乘积惯量为 0。 -->
            <ixx>0.1666666666666667</ixx>
            <iyy>0.1666666666666667</iyy>
            <izz>0.1666666666666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- 碰撞几何不能随 visual 一起删除，否则不会与地面碰撞。 -->
        <collision name="body_collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <sensor name="imu" type="imu">
          <!-- 传感器坐标系与刚体坐标系重合；真机应填写测量到的安装变换。 -->
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/demo/imu</topic>
          <!-- 不配置 noise 时采用无噪声模型，只适合基础配置检查。 -->
        </sensor>
      </link>
    </model>
  </world>
</sdf>
